    public function set(Request $request)
    {

        $cars = ["Ultima", "BMW", "Carerra", "Lamborghini", "Ferrari"];
        $newCollection = session(["cars"=>collect($cars)]);
        session(["cars" => collect($cars)]);

        return "Session set";
        $query = $request->query();
        session($query);
        $request->session()->put($query);
        session(["cars" => ["Ultima","BMW","Carerra", "Lamborghini", "Ferrari"]]);
        session()->push("cars", "Testarossa");
    }

    public function delete(Request $request)
    {

        $car = session("cars")->search("Testarossa");
        session("cars")->forget($car);
        return $car;
        session()->forget("cars");
        return "Session deleted";


        session()->put("cars", array_diff(session()->get("cars"), ["Testarossa"]));
        foreach (session("cars") as $car) {
            if($car === "Testarossa") {
                session()->forget($car);
            }
            session()->forget("cars.$car");
            echo $car;
        }
        session()->forget("name");

        $cars=collect(session("cars"));
